<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/statisticsRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <!-- TOP BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Smart Dribbling"
                android:textColor="@color/primary_blue"
                android:textSize="21sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Leaderboard"
            android:textColor="@color/text_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- FILTER BUTTONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="78dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_filter_selected"
                android:gravity="center"
                android:text="Global"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="78dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_filter_unselected"
                android:gravity="center"
                android:text="Friends"
                android:textColor="@color/primary_blue"
                android:textSize="11sp" />

            <TextView
                android:layout_width="78dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_filter_unselected"
                android:gravity="center"
                android:text="Local"
                android:textColor="@color/primary_blue"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- TOP 3 CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="215dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingTop="16dp"
            android:paddingEnd="12dp"
            android:paddingBottom="14dp">

            <!-- SECOND PLACE -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_avatar_blue"
                        android:padding="8dp"
                        android:src="@drawable/ic_person"
                        app:tint="@color/primary_blue" />

                    <TextView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_rank_silver"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="@android:color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </FrameLayout>

                <TextView
                    android:id="@+id/secondNameText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Marcus U."
                    android:textColor="@color/text_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/secondScoreText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1180"
                    android:textColor="@color/primary_blue"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="64dp"
                    android:layout_height="58dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_podium_silver" />

            </LinearLayout>

            <!-- FIRST PLACE -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="top|center_horizontal"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false">

                <FrameLayout
                    android:layout_width="92dp"
                    android:layout_height="92dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <ImageView
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_avatar_gold"
                        android:padding="10dp"
                        android:src="@drawable/ic_person"
                        app:tint="@color/primary_blue" />

                    <TextView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="top|center_horizontal"
                        android:background="@drawable/bg_star_circle"
                        android:gravity="center"
                        android:text="☆"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="5dp"
                        android:layout_marginBottom="5dp"
                        android:background="@drawable/bg_rank_gold"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@android:color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </FrameLayout>

                <TextView
                    android:id="@+id/firstNameText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sarah Chen"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/firstScoreText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1250"
                    android:textColor="@color/primary_blue"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="70dp"
                    android:layout_height="80dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_podium_gold" />

            </LinearLayout>

            <!-- THIRD PLACE -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_avatar_orange"
                        android:padding="8dp"
                        android:src="@drawable/ic_person"
                        app:tint="@color/primary_blue" />

                    <TextView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_rank_bronze"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="@android:color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </FrameLayout>

                <TextView
                    android:id="@+id/thirdNameText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="David K."
                    android:textColor="@color/text_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/thirdScoreText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1100"
                    android:textColor="@color/primary_blue"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="70dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_podium_bronze" />

            </LinearLayout>

        </LinearLayout>

        <!-- PLAYER 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/fourthRankText"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:text="4"
                android:textColor="@color/primary_blue"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_profile_icon"
                android:padding="7dp"
                android:src="@drawable/ic_person"
                app:tint="@color/primary_blue" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/fourthNameText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alex Rivera"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/fourthAccText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AVG ACC: 94%"
                    android:textColor="@color/text_gray"
                    android:textSize="10sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/fourthScoreText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1085 pts"
                android:textColor="@color/primary_blue"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- PLAYER 5 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/fifthRankText"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:text="5"
                android:textColor="@color/primary_blue"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_profile_icon"
                android:padding="7dp"
                android:src="@drawable/ic_person"
                app:tint="@color/primary_blue" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/fifthNameText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jordan Smith"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/fifthAccText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AVG ACC: 91%"
                    android:textColor="@color/text_gray"
                    android:textSize="10sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/fifthScoreText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1050 pts"
                android:textColor="@color/primary_blue"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- PLAYER 6 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/sixthRankText"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:text="6"
                android:textColor="@color/primary_blue"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_profile_icon"
                android:padding="7dp"
                android:src="@drawable/ic_person"
                app:tint="@color/primary_blue" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sixthNameText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Elena Rodriguez"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sixthAccText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AVG ACC: 89%"
                    android:textColor="@color/text_gray"
                    android:textSize="10sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/sixthScoreText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1022 pts"
                android:textColor="@color/primary_blue"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- CURRENT USER CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_user_rank_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/currentUserRankText"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:text="14"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_profile_icon"
                android:padding="7dp"
                android:src="@drawable/ic_person"
                app:tint="@color/primary_blue" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/currentUserNameText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="You"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/currentUserSubText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL TRAININGS\n0"
                    android:textColor="#DCEBFF"
                    android:textSize="9sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/currentUserScoreText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0\npts"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>