<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="20dp">

        <!-- TOP BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Smart Dribbling"
                android:textColor="@color/primary_blue"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Statistics"
            android:textColor="@color/text_dark"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Track improvement"
            android:textColor="@color/text_gray"
            android:textSize="12sp" />

        <!-- FILTER BUTTONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="70dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_filter_selected"
                android:gravity="center"
                android:text="7 Days"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="70dp"
                android:layout_height="30dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_filter_unselected"
                android:gravity="center"
                android:text="30 Days"
                android:textColor="@color/text_gray"
                android:textSize="10sp" />

            <TextView
                android:layout_width="70dp"
                android:layout_height="30dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_filter_unselected"
                android:gravity="center"
                android:text="All Time"
                android:textColor="@color/text_gray"
                android:textSize="10sp" />

            <TextView
                android:layout_width="82dp"
                android:layout_height="30dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_filter_unselected"
                android:gravity="center"
                android:text="⚽ Football"
                android:textColor="@color/text_gray"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- TOP STATS GRID -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="2">

            <!-- Total -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="78dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total"
                    android:textColor="@color/text_gray"
                    android:textSize="10sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/totalSessionsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="18"
                        android:textColor="@color/primary_blue"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="sessions"
                        android:textColor="@color/text_gray"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Accuracy -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="78dp"
                android:layout_columnWeight="1"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Accuracy"
                    android:textColor="@color/text_gray"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/avgAccuracyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="87% ↗"
                    android:textColor="@color/primary_blue"
                    android:textSize="24sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Avg Score -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="78dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Avg Score"
                    android:textColor="@color/text_gray"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/avgScoreText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="780"
                    android:textColor="@color/text_dark"
                    android:textSize="24sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </GridLayout>

        <!-- PERSONAL BEST CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_personal_best"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Personal Best"
                    android:textColor="@color/primary_blue"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/personalBestText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="920"
                    android:textColor="@color/primary_blue"
                    android:textSize="25sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="🏆"
                android:textSize="18sp" />

        </LinearLayout>

        <!-- PERFORMANCE CHARTS TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Performance Charts"
            android:textColor="@color/text_dark"
            android:textSize="13sp" />

        <!-- SCORE PROGRESS CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Score Progress"
                android:textColor="@color/text_dark"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="118dp"
                android:layout_marginTop="14dp"
                android:background="#FAFAFA"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="#CFE0F5" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="#CFE0F5" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="#CFE0F5" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="74dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="#CFE0F5" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="#CFE0F5" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="92dp"
                    android:layout_weight="1"
                    android:background="#CFE0F5" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:background="@color/primary_blue" />

        </LinearLayout>

        <!-- ACCURACY BREAKDOWN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="155dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Accuracy Breakdown"
                android:textColor="@color/text_dark"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="CONTROL                                      92%"
                android:textColor="@color/text_dark"
                android:textSize="9sp"
                android:textStyle="bold" />

            <ProgressBar
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="4dp"
                android:progress="92"
                android:progressTint="@color/primary_blue"
                android:progressBackgroundTint="#E5E7EB" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="SPEED                                        78%"
                android:textColor="@color/text_dark"
                android:textSize="9sp"
                android:textStyle="bold" />

            <ProgressBar
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="4dp"
                android:progress="78"
                android:progressTint="@color/primary_blue"
                android:progressBackgroundTint="#E5E7EB" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="PRECISION                                    87%"
                android:textColor="@color/text_dark"
                android:textSize="9sp"
                android:textStyle="bold" />

            <ProgressBar
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="4dp"
                android:progress="87"
                android:progressTint="@color/primary_blue"
                android:progressBackgroundTint="#E5E7EB" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>